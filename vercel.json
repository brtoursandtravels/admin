{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://br-tours-and-travels-api.vercel.app/api/v1/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://br-tours-and-travels-api.vercel.app/media/:path*"
    },
    {
      "source": "/admin/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/admin/br-logo.png",
      "destination": "/br-logo.png"
    },
    {
      "source": "/admin/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}
